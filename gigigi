def fetch_page_content(base_url: str, page_id: str, headers: dict) -> dict:
    """Fetch a Confluence page's body, title, and current version."""
    url  = f"{base_url}/rest/api/content/{page_id}?expand=body.storage,version,title,space,ancestors"
    resp = _make_request("GET", url, headers)
    _raise_for_auth(resp)
    resp.raise_for_status()
    d = resp.json()
    return {
        "id"      : d["id"],
        "title"   : d["title"],
        "version" : d["version"]["number"],
        "body"    : d["body"]["storage"]["value"],
        "space"   : d.get("space", {}).get("key", ""),
        "parent"  : (d.get("ancestors") or [{}])[-1].get("id"),
    }


def _next_chapter_number(base_url: str, parent_id: str, headers: dict) -> str:
    """
    Look at all child pages of parent_id, find the highest '3.XX' number,
    and return the next one (e.g. '3.43'). Falls back to '3.41' if none found.
    """
    if not parent_id:
        return "3.41"
    url  = f"{base_url}/rest/api/content/{parent_id}/child/page?limit=200"
    try:
        resp = _make_request("GET", url, headers)
        resp.raise_for_status()
        titles = [r.get("title", "") for r in resp.json().get("results", [])]
    except Exception:
        return "3.41"
    max_minor = 40
    for title in titles:
        m = re.match(r'^3\.(\d+)\b', title.strip())
        if m:
            max_minor = max(max_minor, int(m.group(1)))
    return f"3.{max_minor + 1}"


def create_draft_page(base_url: str, template: dict, filled_body: str,
                      headers: dict, use_case_name: str = "", manual_chapter: str = None) -> dict:
    """
    Create a new Confluence page as a sibling draft of the template page.
    Title format: '<next chapter number> <use_case_name>'
    Chapter number is auto-incremented from existing sibling pages (starts at 3.41).
    """
    label   = use_case_name.strip() if use_case_name.strip() else "Draft"
    if manual_chapter:
        new_title = f"{manual_chapter} {label} draft"
        # Old logic commented out below:
        # chapter = _next_chapter_number(base_url, template.get("parent"), headers)
        # new_title = f"{chapter} {label} draft"
    else:
        chapter = _next_chapter_number(base_url, template.get("parent"), headers)
        new_title = f"{chapter} {label} draft"

    payload = {
        "type" : "page",
        "title": new_title,
        "space": {"key": template["space"]},
        "body" : {
            "storage": {
                "value"         : filled_body,
                "representation": "storage",
            }
        },
    }
    if template.get("parent"):
        payload["ancestors"] = [{"id": template["parent"]}]

    url  = f"{base_url}/rest/api/content"
    resp = _make_request("POST", url, headers, params={"notify": "false"}, data=json.dumps(payload))
    _raise_for_auth(resp)
    resp.raise_for_status()
    new_page = resp.json()

    # Move the new page to appear immediately after the source/template page
    new_id = new_page["id"]
    move_url = f"{base_url}/rest/api/content/{new_id}/move/after/{template['id']}"
    try:
        move_resp = _make_request("PUT", move_url, headers)
        if move_resp.status_code not in (200, 204):
            print(f"  ! Move page warning: {move_resp.status_code} – page created but order may differ")
    except Exception as exc:
        print(f"  ! Move page warning: {exc} – page created but order may differ")

    return new_page


