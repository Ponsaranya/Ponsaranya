def _make_request(method, url, headers, auth=None, params=None, data=None):
    # Use HTTP Basic Auth if credentials are present
    if AUTH_CREDENTIALS:
        auth = (AUTH_CREDENTIALS["username"], AUTH_CREDENTIALS["password"])
    return requests.request(
        method, url,
        headers=headers,
        auth=auth,
        params=params,
        data=data,
        verify=False,
        timeout=30,
    )


def _build_headers(pat: str) -> dict:
    # If using basic auth, do not set Authorization header
    if AUTH_CREDENTIALS:
        return {
            "Content-Type": "application/json",
            "Accept": "application/json",
        }
    return {
        "Authorization": f"Bearer {pat}",
        "Content-Type": "application/json",
        "Accept": "application/json",
    }


def _get_document_producer() -> str:
    try:
        result = subprocess.run(
            ["git", "config", "user.name"],
            capture_output=True, text=True, timeout=5
        )
        name = result.stdout.strip()
        if name:
            return name
    except Exception:
        pass
    return os.environ.get("USERNAME") or os.environ.get("USER") or ""


