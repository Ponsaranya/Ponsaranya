            import traceback
            traceback.print_exc()
            if hasattr(exc, 'response') and exc.response is not None:
                print(f"  Response content: {exc.response.text[:1000]}")
            return
        print("\nGFA Form updated and populated:")
        print(f"  Project Name: {project_name_final}")
        print(f"  SI Link: {TARGET_PAGE_URL}")
        print(f"  GFA Page Link: {GFA_TARGET_URL}")
        print(f"  GFA Page Title: {new_gfa_title}")
    else:
        print("\nDonate changes detected. Please handle changes as required before proceeding to GFA form.")



