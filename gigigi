    # Step 8: Donate changes prompt and GFA automation
    print("\n[Step 8] Donate Changes Check")
    donate_changes = input("  Are there any changes in donate changes as well? (yes/no): ").strip().lower()
    if donate_changes == "no":
        print("\nProceeding to GFA Form Automation...")
        # Always use the fixed GFA template and update the fixed GFA page, just like SI
        GFA_TEMPLATE_ID = "3674448890"
        GFA_TARGET_ID = "3673801437"
        GFA_TARGET_URL = f"{base_url}/pages/viewpage.action?pageId={GFA_TARGET_ID}"
        try:
            gfa_template = fetch_page_content(base_url, GFA_TEMPLATE_ID, headers)
        except Exception as exc:
            print(f"\n  ERROR fetching GFA template: {exc}")
            import traceback
            traceback.print_exc()
            return
        # Prompt for Application Name and Use Case Name
        application_name = input("  Application Name > ").strip()
        while not application_name:
            print("  Application Name cannot be empty.")
            application_name = input("  Application Name > ").strip()

        use_case = input("  Use Case Name > ").strip()
        while not use_case:
            print("  Use Case Name cannot be empty.")
            use_case = input("  Use Case Name > ").strip()

        desc = brd.get("description") or brd.get("objective")
        if not desc:
            desc = input("  Provide a description for the use case > ").strip()
        desc = desc.strip() if desc else ""

        from bs4 import BeautifulSoup
        soup = BeautifulSoup(gfa_template["body"], "html.parser")

        def set_gfa_field(label, value, html=False, append=False):
            label_norm = label.lower().replace(" ","").replace(":","")
            for row in soup.find_all("tr"):
                th = row.find("th")
                td = row.find("td")
                if th and td:
                    th_text = th.get_text(" ", strip=True).lower().replace(" ","").replace(":","")
                    if label_norm == th_text:
                        if append and html:
                            existing_html = str(td.decode_contents())
                            td.clear()
                            td.append(BeautifulSoup(existing_html + value, "html.parser"))
                        else:
                            td.clear()
                            if html:
                                td.append(BeautifulSoup(value, "html.parser"))
                            else:
                                td.append(str(value))

        # 1. Project Name/ID: Format as 'Application Name - Use Case Name', avoid duplication
        # Remove duplicate words (e.g., 'FinSight FinSight ICON')
        def clean_project_name(app, uc):
            app = app.strip()
            uc = uc.strip()
            # Remove app name from start of use case if present
            if uc.lower().startswith(app.lower()):
                uc = uc[len(app):].strip()
            # Remove leading dashes or colons
            uc = uc.lstrip('-:').strip()
            return f"<b>{app} - {uc}</b>"
        project_name_final = clean_project_name(application_name, use_case)
        set_gfa_field("Project Name/ID", project_name_final, html=True)

        # 2. Solution Intent Link (Chapter 2, Chapter 3) - keep as is, but fill SI Link below it
        def set_si_link_in_solution_intent(soup, si_url):
            for row in soup.find_all("tr"):
                th = row.find("th")
                td = row.find("td")
                if th and td:
                    th_text = th.get_text(" ", strip=True).lower().replace(" ","").replace(":","")
                    if th_text == "solutionintentlink(chapter2,chapter3)":
                        # Find or create SI Link line
                        soup_td = BeautifulSoup(str(td.decode_contents()), "html.parser")
                        # Remove any existing SI Link lines
                        for p in soup_td.find_all("p"):
                            if p.get_text(strip=True).lower().startswith("si link"):
                                p.decompose()
                        # Add SI Link line
                        si_link_p = soup_td.new_tag("p")
                        si_link_strong = soup_td.new_tag("strong")
                        si_link_strong.string = "SI Link: "
                        si_link_a = soup_td.new_tag("a", href=si_url)
                        si_link_a.string = si_url
                        si_link_p.append(si_link_strong)
                        si_link_p.append(si_link_a)
                        soup_td.append(si_link_p)
                        td.clear()
                        td.append(soup_td)
        set_si_link_in_solution_intent(soup, TARGET_PAGE_URL)

        # 3. Description of the Project - keep Scope of this SI as is, then add FinSight [Use Case Name]: and Description
        def fill_description_of_project(soup, use_case, desc):
            for row in soup.find_all("tr"):
                th = row.find("th")
                td = row.find("td")
                if th and td:
                    th_text = th.get_text(" ", strip=True).lower().replace(" ","").replace(":","")
                    if th_text == "descriptionoftheproject":
                        # Parse existing content and keep Scope of this SI as is
                        soup_td = BeautifulSoup(str(td.decode_contents()), "html.parser")
                        # Find and keep Scope of this SI
                        new_content = BeautifulSoup("", "html.parser")
                        found_scope = False
                        for el in soup_td.contents:
                            if el.name == 'p' and el.get_text(strip=True).lower().startswith('scope of this si'):
                                new_content.append(el)
                                found_scope = True
                            elif found_scope:
                                # Stop after scope section
                                break
                        # Add Use Case Name (no duplication)
                        if use_case:
                            strong_uc = new_content.new_tag("strong")
                            strong_uc.string = f"{use_case} :"
                            new_content.append(strong_uc)
                            new_content.append(new_content.new_tag("br"))
                        # Add Description
                        if desc:
                            strong_desc = new_content.new_tag("strong")
                            strong_desc.string = "Description"
                            new_content.append(strong_desc)
                            new_content.append(new_content.new_tag("br"))
                            p_desc = new_content.new_tag("p")
                            p_desc.string = desc
                            new_content.append(p_desc)
                        td.clear()
                        td.append(new_content)
        fill_description_of_project(soup, use_case, desc)

        # 4. GFA Engagement Start Date - today in '28 March 2026' format
        from datetime import datetime, timedelta
        today = datetime.now()
        gfa_start_date = today.strftime('%d %B %Y')
        set_gfa_field("GFA Engagement Start Date", gfa_start_date)

        # 5. Expected ARF Date - three weeks after today, on the next Monday
        three_weeks = today + timedelta(weeks=3)
        # If three_weeks is not a Monday (weekday 0), move to the next Monday
        if three_weeks.weekday() == 0:
            arf_date = three_weeks
        else:
            days_until_next_monday = (7 - three_weeks.weekday()) % 7
            if days_until_next_monday == 0:
                days_until_next_monday = 7
            arf_date = three_weeks + timedelta(days=days_until_next_monday)
        arf_date_str = arf_date.strftime('%d %B %Y')
        set_gfa_field("Expected ARF Date", arf_date_str)

        # 6. Detail Elaboration of the Release - only write use case and description, no scope or template duplication, always fill
        def fill_detail_elaboration_nested_table(soup, use_case, desc):
            # Find the 'Detail elaboration of the Release' row
            for row in soup.find_all("tr"):
                th = row.find("th")
                td = row.find("td")
                if th and td:
                    th_text = th.get_text(" ", strip=True).lower().replace(" ","").replace(":","")
                    if th_text == "detailelaborationoftherelease":
                        # Find the nested table
                        nested_table = td.find("table")
                        if not nested_table:
                            return
                        # Find the row where first th is 'Business Driver of Change'
                        for nrow in nested_table.find_all("tr"):
                            n_ths = nrow.find_all("th")
                            n_tds = nrow.find_all("td")
                            if n_ths and n_tds and n_ths[0].get_text(strip=True).lower() == "business driver of change":
                                # Always update the Description cell (even if no change)
                                # Preserve all template content (including Scope of this SI) and append use case/desc
                                preserved = BeautifulSoup(str(n_tds[0].decode_contents()), "html.parser")
                                n_tds[0].clear()
                                for el in preserved.contents:
                                    n_tds[0].append(el)
                                # Always append use case and description after preserved content
                                if use_case:
                                    p_uc = nested_table.new_tag("p")
                                    strong_uc = nested_table.new_tag("strong")
                                    strong_uc.string = f"{use_case} :"
                                    p_uc.append(strong_uc)
                                    n_tds[0].append(p_uc)
                                if desc:
                                    p_desc = nested_table.new_tag("p")
                                    strong_desc = nested_table.new_tag("strong")
                                    strong_desc.string = "Description"
                                    p_desc.append(strong_desc)
                                    n_tds[0].append(p_desc)
                                    p_desc2 = nested_table.new_tag("p")
                                    p_desc2.string = desc
                                    n_tds[0].append(p_desc2)
                                break
        fill_detail_elaboration_nested_table(soup, use_case, desc)
                
        # 4. GFA Engagement Start Date
        set_gfa_field("GFA Engagement Start Date", today.strftime("%Y-%m-%d"))
        # 5. Expected ARF Date (next Monday after 3 weeks)
        arf_date = today + timedelta(weeks=3)
        while arf_date.weekday() != 0:
            arf_date += timedelta(days=1)
        set_gfa_field("Expected ARF Date", arf_date.strftime("%Y-%m-%d"))
        # 6. Detail Elaboration of the Release (fill if available)
        detail = brd.get("detail_elaboration_of_the_release") or brd.get("business_driver_of_change") or ""
        if detail:
            for row in soup.find_all("tr"):
                ths = row.find_all("th")
                tds = row.find_all("td")
                if ths and tds and len(ths) == 1 and "business driver of change" in ths[0].get_text(strip=True).lower():
                    tds[0].clear()
                    tds[0].append(str(detail))

        # Debug print to confirm update
        print("\n[DEBUG] GFA HTML about to be updated. First 500 chars:\n", str(soup)[:500])
