def _fill_response_column(heading_tag, responses: list) -> bool:
    h_level = int(heading_tag.name[1])
    node  = heading_tag.next_sibling
    table = None
    while node is not None:
        if hasattr(node, 'name') and node.name:
            if node.name == 'table':
                table = node; break
            inner = node.find('table') if callable(getattr(node, 'find', None)) else None
            if inner:
                table = inner; break
            if re.match(r'^h[1-6]$', node.name, re.I) and int(node.name[1]) <= h_level:
                break
        node = node.next_sibling

    if not table:
        return False

    rows = table.find_all('tr')
    if not rows:
        return False

    header_cells = rows[0].find_all(['th', 'td'])
    resp_idx = next(
        (i for i, c in enumerate(header_cells) if 'response' in c.get_text(strip=True).lower()),
        None
    )
    if resp_idx is None:
        return False

    data_rows = [r for r in rows[1:] if r.find_all('td')]
    for row_el, resp_val in zip(data_rows, responses):
        tds = row_el.find_all('td')
        if resp_idx < len(tds) and str(resp_val).strip():
            tds[resp_idx].clear()
            tds[resp_idx].append(BeautifulSoup(f'<p>{e(str(resp_val))}</p>', 'html.parser'))
    return True


