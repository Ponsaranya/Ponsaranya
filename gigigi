def process_template(body: str, brd: dict, producer_name: str, use_case: str = "") -> tuple:
    """
    Fill BRD data into the template body.
    Returns (filled_body_str, unfilled_sections_list).
    """
    soup = BeautifulSoup(body, "html.parser")
    _fill_chapter_approval_dates(soup, producer_name)
    all_headings = soup.find_all(re.compile(r'^h[1-6]$', re.I))

    print(f"\n  Template headings ({len(all_headings)} found):")
    for i, h in enumerate(all_headings):
        print(f"    [{i:02d}] {h.name}: {h.get_text(separator=' ', strip=True)[:80]}")

    filled_sections   = []
    unfilled_sections = []

    for keywords, builder in SECTION_MAP:
        target_h = None
        # First pass: require ALL keywords to match (strict)
        for h in all_headings:
            n = _norm(h.get_text(separator=' ', strip=True))
            if all(kw in n for kw in keywords):
                target_h = h
                break
        # Second pass: any-keyword fallback (catches numbered/shortened headings)
        if target_h is None and len(keywords) > 1:
            for h in all_headings:
                n = _norm(h.get_text(separator=' ', strip=True))
                if any(kw in n for kw in keywords):
                    # Also ensure the *first* keyword still appears (anchor word)
                    if keywords[0] in n:
                        target_h = h
                        break

        if target_h is None:
            print(f"  \u2717 Not found  : {keywords}")
            continue

        label = target_h.get_text(separator=' ', strip=True)[:70]

        if builder == "KEEP":
            print(f"  \u25a0 Keep       : {label}")
            continue

        # RESPONSE_ONLY — fill only the Response column in the template's table
        if isinstance(builder, tuple) and builder[0] == "RESPONSE_ONLY":
            ok = _fill_response_column(target_h, builder[1](brd))
            if ok:
                print(f"  ~ Response   : {label}")
                filled_sections.append(label)
            else:
                print(f"  ! No table   : {label}")
                unfilled_sections.append(label)
            continue

        # FILL — inject BRD values into the template's existing structure
        if isinstance(builder, tuple) and builder[0] == "FILL":
            fn = builder[1]
            # pass use_case only to fill_expected_outcomes
            if fn is fill_expected_outcomes:
                ok = fn(target_h, brd, use_case)
            else:
                ok = fn(target_h, brd)
            if ok:
                print(f"  \u2713 Fill       : {label}")
                filled_sections.append(label)
            else:
                print(f"  \u26a0 Skipped    : {label}  (insufficient BRD data or table not found)")
                unfilled_sections.append(label)
            continue

    print(f"\n  Filled: {len(filled_sections)}  |  Skipped/unfilled: {len(unfilled_sections)}")
    return str(soup), unfilled_sections


