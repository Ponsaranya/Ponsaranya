def e(v) -> str:
    s = str(v or "").strip().replace("<br>", " | ").replace("<br/>", " | ")
    return escape(s)

def conf_table(headers: list, rows: list) -> str:
    th   = "".join(f"<th><p><strong>{e(h)}</strong></p></th>" for h in headers)
    body = ""
    for row in rows:
        cells = (list(row) + [""] * len(headers))[:len(headers)]
        body += "<tr>" + "".join(f"<td><p>{e(c)}</p></td>" for c in cells) + "</tr>"
    return f"<table><tbody><tr>{th}</tr>{body}</tbody></table>"

def conf_list(items: list) -> str:
    lis = "".join(f"<li>{e(i)}</li>" for i in items if str(i).strip())
    return f"<ul>{lis}</ul>" if lis else ""

def conf_p(text) -> str:
    return f"<p>{e(text)}</p>" if str(text).strip() else ""

def _norm(s: str) -> str:
    return re.sub(r'[\W_]+', ' ', s.lower()).strip()

def _section(brd: dict, *keys) -> str:
    for kw in keys:
        k = next((k for k in brd if kw in k and not k.startswith("__")), None)
        if k: return brd[k]
    return ""

def _bullets(text: str) -> list:
    out = []
    for line in text.splitlines():
        s = line.strip()
        if re.match(r'^[-*\u2022]\s+', s):    out.append(re.sub(r'^[-*\u2022]\s+', '', s))
        elif re.match(r'^\d+[.)]\s+', s): out.append(re.sub(r'^\d+[.)]\s+', '', s))
    return out

def _sentences(text: str) -> list:
    t = re.sub(r'\s+', ' ', text.replace('\n', ' ')).strip()
    return [s.strip() for s in re.split(r'(?<=[.!?])\s+', t) if s.strip()]

def _infer(all_text: str, yes_kws, no_kws=None, na_kws=None) -> str:
    tl = all_text.lower()
    if any(k in tl for k in (yes_kws or [])): return "YES"
    if any(k in tl for k in (no_kws  or [])): return "NO"
    if any(k in tl for k in (na_kws  or [])): return "NA"
    return ""

def _parse_md_table(text: str) -> tuple:
    lines = [l.strip() for l in text.splitlines() if l.strip().startswith("|")]
    if len(lines) < 3: return [], []
    def split(l): return [c.strip().replace("<br>", " | ").replace("<br/>", " | ") for c in l.strip("|").split("|")]
    headers = split(lines[0])
    rows, prev = [], ""
    for l in lines[2:]:
        cols = (split(l) + [""] * len(headers))[:len(headers)]
        cols[0] = cols[0] or prev
        prev = cols[0]
        rows.append(cols)
    return headers, rows


# ══════════════════════════════════════════════════════════════════════════════
#  TEMPLATE-AWARE SECTION FILLERS
#  All functions operate directly on the fetched Confluence template HTML.
#  They NEVER rebuild tables — they only inject BRD-derived values into the
#  existing template structure.
#
#  Signature: fill_*(heading_tag, brd) -> bool  (True = something was filled)
# ══════════════════════════════════════════════════════════════════════════════

def _next_sibling_table(heading_tag):
    """Return the first <table> found after heading_tag (before next same-level heading)."""
    h_level = int(heading_tag.name[1])
    node = heading_tag.next_sibling
    while node:
        if hasattr(node, 'name') and node.name:
            if node.name == 'table':
                return node
            inner = node.find('table') if callable(getattr(node, 'find', None)) else None
            if inner:
                return inner
            if re.match(r'^h[1-6]$', node.name, re.I) and int(node.name[1]) <= h_level:
                break
        node = node.next_sibling
    return None


def _set_cell(td, value):
    """Overwrite a single table cell with plain text."""
    td.clear()
    td.append(BeautifulSoup(f'<p>{e(str(value))}</p>', 'html.parser'))


def _col_idx(header_cells, *keywords):
    """Return the index of the first header cell matching any keyword."""
    for i, cell in enumerate(header_cells):
        text = cell.get_text(strip=True).lower()
        if any(kw.lower() in text for kw in keywords):
            return i
    return None


def _empty_row(num_cols):
    """Create a new <tr> with num_cols empty <td> cells."""
    return BeautifulSoup(
        '<tr>' + '<td><p></p></td>' * num_cols + '</tr>', 'html.parser'
    ).find('tr')


def _make_col_map(table):
    """
    Build a mapping of normalized_header_text -> absolute_column_index for data rows.
    Handles multi-row headers with colspan/rowspan, INCLUDING sub-header rows
    that use <td> instead of <th> (common in redesigned Confluence templates).
    Stops processing once it hits an actual data row (mostly empty cells).
    """
    col_map = {}
    rowspan_holds = {}  # col_idx -> remaining rows still held

    for row in table.find_all('tr'):
        cells = row.find_all(['th', 'td'])
        if not cells:
            continue
        has_th = bool(row.find('th'))
        non_empty = sum(1 for c in cells if c.get_text(strip=True))

        # A row is a header/sub-header if it has <th> tags OR
        # if more than half its cells have text (sub-header pattern with <td>).
        # An actual data row is mostly empty (template placeholder).
        is_header_like = has_th or (non_empty > len(cells) // 2)
        if not is_header_like:
            break  # Hit actual data rows — stop mapping

        abs_col = 0
        for cell in cells:
            # Advance past positions still held by rowspan from above rows
            while abs_col in rowspan_holds:
                rowspan_holds[abs_col] -= 1
                if rowspan_holds[abs_col] == 0:
                    del rowspan_holds[abs_col]
                abs_col += 1
            text    = _norm(cell.get_text(separator=' ', strip=True))
            colspan = int(cell.get('colspan', 1))
            rowspan = int(cell.get('rowspan', 1))
            if text and text not in col_map:
                col_map[text] = abs_col
            if rowspan > 1:
                for c in range(abs_col, abs_col + colspan):
                    rowspan_holds[c] = rowspan - 1
            abs_col += colspan
    return col_map


def fill_expected_outcomes(heading_tag, brd, use_case: str = ""):
    """
    Fill Expected Outcomes section while preserving the template structure
    (info macro, 'Scope of this SI' label, etc.).

    - Sets 'Scope of this SI' to the BRD title.
    - Synthesizes up to 10 detailed bullet points from multiple BRD sections.
    - Appends fixed out-of-scope line.
    """
    use_case = use_case.strip() or brd.get("title", "").strip()

    # Pull content from multiple relevant BRD sections in priority order
    section_keys = [
        "expected_outcome", "expected outcome",
        "objective", "business_objective", "business objective", "business need",
        "scope", "background", "project_background",
        "requirement", "functional_requirement",
        "deliverable", "benefit",
    ]
    bullet_pool = []
    sentence_pool = []
    seen_norm = set()

    for key in section_keys:
        text = _section(brd, key)
        if not text:
            continue
        found = _bullets(text)
        if found:
            for b in found:
                n = re.sub(r'\s+', ' ', b).strip().lower()
                if n and n not in seen_norm and len(n) > 15:
                    seen_norm.add(n)
                    bullet_pool.append(b.strip())
        else:
            for s in _sentences(text):
                n = re.sub(r'\s+', ' ', s).strip().lower()
                if n and n not in seen_norm and len(n) > 30:
                    seen_norm.add(n)
                    sentence_pool.append(s.strip())

    # Prefer explicit bullets; supplement with sentences to reach 10
    combined = bullet_pool[:10]
    if len(combined) < 10:
        combined += sentence_pool[:10 - len(combined)]
    bullet_list = combined[:10]

    if not bullet_list and not use_case:
        return False

    # Fixed out-of-scope line always appended at the end
    out_of_scope = "Out of Scope: How the metrics are derived in the upstream is out of scope."

    h_level = int(heading_tag.name[1])
    # Collect all sibling nodes in this section
    section_nodes = []
    node = heading_tag.next_sibling
    while node:
        if hasattr(node, 'name') and node.name:
            if re.match(r'^h[1-6]$', node.name, re.I) and int(node.name[1]) <= h_level:
                break
        section_nodes.append(node)
        node = node.next_sibling

    # 1. Update 'Scope of this SI' paragraph in-place (preserves info macro above)
    if use_case:
        for sn in section_nodes:
            if not hasattr(sn, 'get_text'):
                continue
            if 'scope of this si' in sn.get_text(separator=' ', strip=True).lower():
                p = sn if (hasattr(sn, 'name') and sn.name == 'p') else (
                    sn.find('p') if hasattr(sn, 'find') else None)
                if p:
                    p.clear()
                    p.append(BeautifulSoup(
                        f'<strong>Scope of this SI:</strong>\u00a0 {e(use_case)}',
                        'html.parser'))
                    break

    # 2. Fill bullet list; replace existing <ul>/<ol>, or append new one
    all_items = bullet_list + [out_of_scope]
    li_html  = ''.join(f'<li><p>{e(item)}</p></li>' for item in all_items)
    new_ul   = BeautifulSoup(f'<ul>{li_html}</ul>', 'html.parser').find('ul')

    existing_ul = None
    for sn in section_nodes:
        if hasattr(sn, 'name'):
            if sn.name in ('ul', 'ol'):
                existing_ul = sn
                break
            found = sn.find(['ul', 'ol']) if hasattr(sn, 'find') else None
            if found:
                existing_ul = found
                break

    if existing_ul:
        existing_ul.replace_with(new_ul)
    else:
        anchor = section_nodes[-1] if section_nodes else heading_tag
        anchor.insert_after(new_ul)

    return True


def fill_integration_table(heading_tag, brd):
    """Fill Integration Architecture table with BRD-derived rows."""
    table = _next_sibling_table(heading_tag)
    if not table:
        return False

    text = _section(brd, "integration_architecture", "integration")
    sender_pat = re.compile(
        r"(FPSL|Hadoop\s*\(FDP\)|S4GL|Aspire\s+Data\s+Factory\s*\(Postgres\))"
        r"\s*\((?:CMDB\s+ID:\s*)?(\d{4,6})\)", re.I)
    senders = sender_pat.findall(text)
    if not senders:
        return False

    recv_m   = re.search(r"(EFDNA[^\(\)\n]*?)\((\d+)\)", text, re.I)
    receiver = f"{recv_m.group(2)} \u2013 {recv_m.group(1).strip()}" if recv_m else "EFDNA"
    interface = "ODBC" if "ODBC" in text else ""
    batch     = "Batch \u2013 Daily" if "daily" in text.lower() else "Batch"
    conf_val  = "Confidential" if "confidential" in text.lower() else "Internal"
    golden    = "Yes" if "golden source" in text.lower() else "No"

    all_rows = table.find_all('tr')
    if not all_rows:
        return False
    header_cells = all_rows[0].find_all(['th', 'td'])
    num_cols = len(header_cells)

    # Column index helpers
    def col(*kws): return _col_idx(header_cells, *kws)
    sender_c   = col("sender")
    receiver_c = col("receiver")
    iface_c    = col("interface", "mechanism")
    batch_c    = col("batch", "online")
    entity_c   = col("entity", "exchanged")
    pii_c      = col("pii", "pci", "confidential", "restricted")
    facing_c   = col("external", "internal facing")
    golden_c   = col("golden source", "golden")

    # Remove existing data rows (keep header only)
    for row in all_rows[1:]:
        row.extract()

    tbody = table.find('tbody') or table
    for name, cmdb in senders:
        tr = _empty_row(num_cols)
        tds = tr.find_all('td')
        def s(idx, val):
            if idx is not None and idx < len(tds):
                _set_cell(tds[idx], val)
        s(sender_c,   f"{cmdb} \u2013 {name.strip()}")
        s(receiver_c, receiver)
        s(iface_c,    interface)
        s(batch_c,    batch)
        s(entity_c,   "Control metrics / financial data")
        s(pii_c,      conf_val)
        s(facing_c,   "Internal")
        s(golden_c,   golden)
        tbody.append(tr)
    return True


def fill_technologies_table(heading_tag, brd):
    """Fill Technologies Adopted table with BRD-derived rows."""
    table = _next_sibling_table(heading_tag)
    if not table:
        return False

    text   = _section(brd, "technologies_adopted", "technolog")
    cmdb_m = re.search(r"CMDB\s+ID:\s*(\d+)", text)
    app_v  = f"{cmdb_m.group(1)} \u2013 EFDNA" if cmdb_m else "EFDNA"
    host_m = re.search(r"hosted.*?(AWS\s+\w+)", text, re.I)
    hosting = host_m.group(1) if host_m else "AWS Singapore"
    invest  = "Retained" if "retained" in text.lower() else "New"
    avail   = "High" if "high availability" in text.lower() else ""

    brd_rows = []
    for line in text.splitlines():
        s = line.strip()
        if not re.match(r'^[-*\u2022]', s):
            continue
        s = re.sub(r'^[-*\u2022]\s*', '', s)
        pur_m = re.match(r'(?:For|To)\s+(.+?),', s, re.I)
        purpose = pur_m.group(1).strip().title() if pur_m else ""
        tech_m = re.search(
            r'(?:utilizes?|adopts?|is\s+used|is\s+employed)\s+([A-Z][\w\s,]+?)'
            r'\s+(?:as\s+the|to\s+create|to\s+build)', s, re.I)
        tech = tech_m.group(1).strip() if tech_m else ""
        if not tech:
            fb = re.search(r'(SAC|Datasphere|HANA\s+Cloud|SAP\s+Work\s+Zone|SAP\s+Cloud\s+Foundry)', s, re.I)
            tech = fb.group(0) if fb else ""
        model_m = re.search(r'with\s+([\w]+)\s+as\s+the\s+(?:technology\s+)?model', s, re.I)
        model = model_m.group(1).strip() if model_m else ""
        if tech or purpose:
            brd_rows.append((app_v, purpose, "", tech, model, invest, hosting, hosting, avail, invest))

    if not brd_rows:
        return False

    all_rows = table.find_all('tr')
    if not all_rows:
        return False
    header_cells = all_rows[0].find_all(['th', 'td'])
    num_cols = len(header_cells)

    def col(*kws): return _col_idx(header_cells, *kws)
    app_c    = col("business application", "cmdb")
    pur_c    = col("purpose")
    gts_c    = col("gts", "component")
    tech_c   = col("technology name")
    model_c  = col("model", "version")
    invest_c = col("investment")
    host_c   = col("primary")
    dr_c     = col("dr", "secondary")
    avail_c  = col("availability")
    impact_c = col("impact", "deprecated")

    for row in all_rows[1:]:
        row.extract()

    tbody = table.find('tbody') or table
    for app_v2, pur_v, gts_v, tech_v, model_v, inv_v, host_v, dr_v, avail_v, imp_v in brd_rows:
        tr = _empty_row(num_cols)
        tds = tr.find_all('td')
        def s(idx, val):
            if idx is not None and idx < len(tds):
                _set_cell(tds[idx], val)
        s(app_c, app_v2); s(pur_c, pur_v);  s(gts_c, gts_v);  s(tech_c, tech_v)
        s(model_c, model_v); s(invest_c, inv_v); s(host_c, host_v)
        s(dr_c, dr_v); s(avail_c, avail_v); s(impact_c, imp_v)
        tbody.append(tr)
    return True


def fill_security_link_table(heading_tag, brd):
