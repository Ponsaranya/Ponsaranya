def parse_brd(filepath: str) -> dict:
    filepath = os.path.abspath(filepath)
    if not os.path.isfile(filepath):
        raise FileNotFoundError(f"BRD not found: {filepath}")
    print(f"  Reading : {filepath}")

    with open(filepath, encoding="utf-8") as f:
        raw_lines = [line.rstrip("\n") for line in f]

    # Detect whether the BRD uses markdown headings (## ...) or plain-text headings
    has_markdown_headings = any(
        l.startswith("## ") or (l.startswith("# ") and not l.startswith("## "))
        for l in raw_lines
    )

    def _is_plain_heading(line: str) -> bool:
        """Heuristic: short line with no markdown/bullet markers and no sentence-ending punctuation."""
        s = line.strip()
        if not s or len(s) > 80:
            return False
        if re.match(r'^[-*\u2022]', s):      # bullet
            return False
        if re.match(r'^\d+[.)]\s', s):        # numbered list item
            return False
        if s.endswith(('.', '!', '?', ',')):   # looks like a sentence
            return False
        return True

    sections, current_key, buffer = {}, None, []

    def flush():
        if current_key is not None:
            sections[current_key] = "\n".join(buffer).strip()

    for line in raw_lines:
        if line.startswith("# ") and not line.startswith("## "):
            sections["title"] = line[2:].strip(); current_key = None; buffer = []
        elif line.startswith("## "):
            flush(); buffer = []
            h = re.sub(r"^\d+[\.\)]\s*", "", line[3:].strip())
            current_key = re.sub(r"\W+", "_", h.lower()).strip("_")
        elif line.startswith("###") or line.startswith("####"):
            buffer.append(line.lstrip("#").strip())
        elif not has_markdown_headings and _is_plain_heading(line):
            # Plain-text heading detection for non-markdown BRDs
            flush(); buffer = []
            h = re.sub(r"^\d+[\.\)]\s*", "", line.strip())
            current_key = re.sub(r"\W+", "_", h.lower()).strip("_")
        else:
            buffer.append(line)
    flush()
    sections["__all__"]    = " ".join(v for k, v in sections.items() if not k.startswith("__"))
    sections["__source__"] = os.path.basename(filepath)
    print(f"  Sections: {[k for k in sections if not k.startswith('__')]}")
    return sections


