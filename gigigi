# ══════════════════════════════════════════════════════════════════════════════

def _fill_chapter_approval_dates(soup, producer_name: str):
    from datetime import date
    today = date.today()
    three_wk = today + timedelta(weeks=3)
    days_to_mon = (7 - three_wk.weekday()) % 7
    end_date = three_wk if days_to_mon == 0 else three_wk + timedelta(days=days_to_mon)
    start_str = today.strftime("%d-%b-%Y")
    end_str   = end_date.strftime("%d-%b-%Y")

    for tbl in soup.find_all("table"):
        first_row = tbl.find("tr")
        if not first_row:
            continue
        headers = [c.get_text(strip=True).lower() for c in first_row.find_all(["th", "td"])]
        if "start date" in headers and "date" in headers:
            si = headers.index("start date")
            ei = headers.index("date")
            dp_idx = next((i for i, h in enumerate(headers) if "document producer" in h), None)
            data_rows = [r for r in tbl.find_all("tr")[1:] if r.find_all("td")]
            if data_rows:
                tds = data_rows[0].find_all("td")
                if si < len(tds):
                    tds[si].clear()
                    tds[si].append(BeautifulSoup(f"<p>{start_str}</p>", "html.parser"))
                if ei < len(tds):
                    tds[ei].clear()
                    tds[ei].append(BeautifulSoup(f"<p>{end_str}</p>", "html.parser"))
                if dp_idx is not None and dp_idx < len(tds) and producer_name:
                    tds[dp_idx].clear()
                    tds[dp_idx].append(BeautifulSoup(f"<p>{escape(producer_name)}</p>", "html.parser"))
            print(f"  \u2713 Dates      : {start_str}  \u2192  {end_str}")
            print(f"  \u2713 Producer   : {producer_name}")
            return
    print("  ! Dates     : Chapter Approval Status table not found")


