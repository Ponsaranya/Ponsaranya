def extract_page_id_from_url(url: str) -> str:
    """
    Extract the numeric page ID from a Confluence URL.

    Supported formats:
      • /pages/viewpage.action?pageId=1234567890
      • /display/SPACEKEY/Page+Title
    Returns the page ID string, or raises ValueError.
    """
    # Format 1: explicit pageId parameter
    m = re.search(r'[?&]pageId=(\d+)', url)
    if m:
        return m.group(1)

    # Format 2: /display/SPACE/Title — need to do an API lookup
    return None   # signal: need API lookup


def get_page_by_url(url: str, headers: dict) -> tuple:
    """
    Fetch Confluence page data from its URL.
    Returns (page_data_dict, base_url_str).
    """
    base_url_m = re.match(r'(https?://[^/]+)', url)
    if not base_url_m:
        raise ValueError("Could not parse base URL from the provided link.")
    base_url = base_url_m.group(1)

    # --- pageId= format ---
    m = re.search(r'[?&]pageId=(\d+)', url)
    if m:
        page_id = m.group(1)
        api_url = f"{base_url}/rest/api/content/{page_id}?expand=body.storage,version,ancestors,space,title"
        resp = _make_request("GET", api_url, headers)
        _raise_for_auth(resp)
        resp.raise_for_status()
        return resp.json(), base_url

    # --- /display/SPACE/Title format ---
    m = re.search(r'/display/([^/]+)/([^?#]+)', url)
    if m:
        space_key  = m.group(1)
        page_title = m.group(2).replace('+', ' ').replace('%20', ' ')
        print(f"  Space : {space_key}   Title : {page_title}")
        api_url = f"{base_url}/rest/api/content"
        params  = {
            "spaceKey": space_key,
            "title"   : page_title,
            "expand"  : "body.storage,version,ancestors,space",
        }
        resp = _make_request("GET", api_url, headers, params=params)
        _raise_for_auth(resp)
        resp.raise_for_status()
        results = resp.json().get("results", [])
        if not results:
            raise ValueError(f"Page '{page_title}' not found in space '{space_key}'.")
        return results[0], base_url

    raise ValueError(
        "Could not parse Confluence page URL.\n"
        "Supported formats:\n"
        "  • https://confluence.example.com/pages/viewpage.action?pageId=1234567890\n"
        "  • https://confluence.example.com/display/SPACEKEY/Page+Title"
    )


def _raise_for_auth(resp):
    if resp.status_code == 401:
        raise PermissionError(
            "401 Unauthorized — Authentication failed.\n"
            "  > Check your username and password."
        )


