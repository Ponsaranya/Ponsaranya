def fill_app_impact_table(heading_tag, brd):
    """
    Fill the Application-level Impact table with BRD-derived values.

    Uses _make_col_map to correctly handle the redesigned multi-row merged-header
    table (colspan/rowspan) so column indices align with actual <td> positions.
    Only fills a cell when a value is available; leaves it empty otherwise.
    """
    table = _next_sibling_table(heading_tag)
    if not table:
        return False

    text = _section(brd, "application_level_impact", "application_impact")
    t    = brd.get("__all__", "")
    def r(y, n=None, na=None): return _infer(t, y, n, na)

    # --- BRD-derived values ---
    cmdb_m   = re.search(r"(?:CMDB\s+ID|Business Application ID):\s*(\d+)", text)
    cmdb     = cmdb_m.group(1) if cmdb_m else ""
    app_m    = re.search(r"(EFDNA[\w\s]*?)\s+(?:application|FinSight)", text, re.I)
    app      = app_m.group(0).strip() if app_m else ""
    inst_m   = re.search(r"(EFDNA\s+FinSight\s+ICON\s+PROD\s+AS)", text, re.I)
    inst     = inst_m.group(1) if inst_m else ""
    hosting  = "3. SaaS" if "saas" in text.lower() else ("2. PaaS" if text else "")
    arch_sig = ("Significant" if "architecturally significant" in text.lower()
                else ("Not Significant" if text else ""))
    desc_m   = re.search(r"(new\s+(?:dashboards?|capability|reporting)[^.]+\.)", text, re.I)
    desc     = desc_m.group(1) if desc_m else (_sentences(text)[0] if _sentences(text) else "")

    # --- Build colspan-aware column map from ALL header rows ---
    col_map = _make_col_map(table)

    def col(*kws):
        """Return index of first col_map entry whose label contains any keyword."""
        for kw in kws:
            for label, idx in col_map.items():
                if kw in label:
                    return idx
        return None

    # --- Map column keywords → BRD values (only non-empty values are written) ---
    fill_map = {}
    def reg(idx, val):
        if idx is not None and str(val).strip():
            fill_map[idx] = val

    reg(col("business application id", "cmdb id"),  cmdb)
    reg(col("business application name"),            app)
    reg(col("application service", "instance name", "service instance"), inst)
    reg(col("application hosting", "hosting"),       hosting)
    reg(col("architecturally significant"),          arch_sig)
    reg(col("description"),                          desc)
    reg(col("software change"),  r(["code change","software change","development"], [], []))
    reg(col("architecture change"), r(["architecture change","new architecture"], [], []))
    reg(col("inbound"),          r(["inbound","source","ingestion","odbc"]))
    reg(col("outbound"),         r(["outbound","downstream","publish","efdna"]))
    reg(col("integration"),      r(["integration","interface","odbc"]))
    reg(col("end to end", "e2e"), "Yes")
    reg(col("location"),         r([], ["no change to location","no location change"]))
    reg(col("volume"),           r([], ["no change to volume","no volume change"]))
    reg(col("performance"),      r([], ["no change to performance","no performance impact"]))
    reg(col("resilience"),       r([], ["no change to resilience","no resilience change"]))
    reg(col("capacity"),         r([], ["no change to capacity","no capacity change"]))

    if not fill_map:
        return False

    # --- Find data rows: skip ALL header/sub-header rows at the top ---
    # A header-like row has <th> OR more than half its cells are non-empty text.
    # Actual data rows (template placeholders) are mostly empty.
    all_rows = table.find_all('tr')
    header_row_count = 0
    for row in all_rows:
        cells = row.find_all(['th', 'td'])
        if not cells:
            break
        non_empty = sum(1 for c in cells if c.get_text(strip=True))
        if row.find('th') or non_empty > len(cells) // 2:
            header_row_count += 1
        else:
            break  # first row that looks like a data row

    data_rows = all_rows[header_row_count:]
    num_cols  = max((len(rw.find_all('td')) for rw in data_rows), default=len(col_map))
    tbody     = table.find('tbody') or table

    if data_rows:
        # Update existing data rows in-place — preserves redesigned template structure
        for row_el in data_rows:
            tds = row_el.find_all('td')
            for idx, val in fill_map.items():
                if idx < len(tds):
                    _set_cell(tds[idx], val)
    else:
        # Template has no data rows yet — insert one
        tr  = _empty_row(num_cols)
        tds = tr.find_all('td')
        for idx, val in fill_map.items():
            if idx < len(tds):
                _set_cell(tds[idx], val)
        tbody.append(tr)

    return True


