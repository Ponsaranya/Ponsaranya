def update_existing_page(base_url: str, page_id: str, filled_body: str, headers: dict, new_title: str = None) -> dict:
    """
    Update an existing Confluence page by page ID with new content and (optionally) a new title.
    """
    # Fetch current version
    url = f"{base_url}/rest/api/content/{page_id}?expand=version"
    resp = _make_request("GET", url, headers)
    _raise_for_auth(resp)
    resp.raise_for_status()
    page_data = resp.json()
    current_version = page_data["version"]["number"]
    payload = {
        "version": {"number": current_version + 1},
        "title": new_title or page_data["title"],
        "type": "page",
        "body": {
            "storage": {
                "value": filled_body,
                "representation": "storage"
            }
        }
    }
    update_url = f"{base_url}/rest/api/content/{page_id}"
    update_resp = _make_request("PUT", update_url, headers, data=json.dumps(payload))
    _raise_for_auth(update_resp)
    update_resp.raise_for_status()
    return update_resp.json()
