import easyocr
import pdfplumber
import re
import pandas as pd
from PIL import Image
import numpy as np

# Initialize EasyOCR once
reader = easyocr.Reader(['en'])

# ---------- OCR FUNCTION ----------
def extract_text(file):
    text = ""

    if file.type == "application/pdf":
        with pdfplumber.open(file) as pdf:
            for page in pdf.pages:
                page_text = page.extract_text()
                if page_text:
                    text += page_text

    else:
        image = Image.open(file)
        img_array = np.array(image)
        result = reader.readtext(img_array)
        text = " ".join([res[1] for res in result])

    return text


# ---------- ACCOUNT DETAILS ----------
def extract_account_details(text):
    name = re.search(r'Name\s*[:\-]\s*(.*)', text)
    acc = re.search(r'Account\s*(No|Number)\s*[:\-]\s*(\d+)', text)

    return {
        "Name": name.group(1).strip() if name else "Not Found",
        "Account Number": acc.group(2) if acc else "Not Found"
    }


# ---------- TRANSACTIONS ----------
def extract_transactions(text):
    rows = []
    pattern = r'(\d{2}/\d{2}/\d{4})\s+(.*?)\s+([\d,]+\.\d{2})?\s+([\d,]+\.\d{2})'

    for match in re.finditer(pattern, text):
        rows.append({
            "Date": match.group(1),
            "Description": match.group(2),
            "Debit": float(match.group(3).replace(",", "")) if match.group(3) else 0,
            "Credit": float(match.group(4).replace(",", "")) if match.group(4) else 0
        })

    return pd.DataFrame(rows)


# ---------- ABBREVIATIONS ----------
ABBREVIATIONS = {
    "UPI": "Unified Payments Interface",
    "IMPS": "Immediate Payment Service",
    "NEFT": "National Electronic Funds Transfer",
    "ATM": "Cash Withdrawal",
    "POS": "Card Payment",
    "EMI": "Loan Repayment"
}

def find_abbreviations(df):
    found = {}
    for desc in df["Description"]:
        for abbr, meaning in ABBREVIATIONS.items():
            if abbr in desc.upper():
                found[abbr] = meaning
    return found


# ---------- EXPENSE CATEGORIZATION ----------
def categorize_expenses(df):
    categories = {
        "Food": ["ZOMATO", "SWIGGY"],
        "Shopping": ["AMAZON", "FLIPKART"],
        "Cash": ["ATM"],
        "Transfer": ["UPI", "IMPS", "NEFT"],
        "Charges": ["CHARGE"]
    }

    df["Category"] = "Others"
    for cat, keys in categories.items():
        for key in keys:
            df.loc[df["Description"].str.upper().str.contains(key), "Category"] = cat

    return df
