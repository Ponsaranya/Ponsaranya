import requests
import time

# 🔹 Change model name if needed
MODEL_NAME = "qwen2.5"

prompt = "Explain RAG architecture in simple words."

start_time = time.time()

response = requests.post(
    "http://localhost:11434/api/generate",
    json={
        "model": MODEL_NAME,
        "prompt": prompt,
        "stream": False
    }
)

end_time = time.time()

data = response.json()
output_text = data.get("response", "")

# 🔹 Calculate metrics
elapsed_time = end_time - start_time
tokens = data.get("eval_count", 0)  # generated tokens
tokens_per_sec = tokens / elapsed_time if elapsed_time > 0 else 0

print("\n✅ Response:\n", output_text)
print("\n⏱️ Time taken:", round(elapsed_time, 2), "seconds")
print("🔢 Tokens generated:", tokens)
print("⚡ Tokens/sec:", round(tokens_per_sec, 2))
