import re
import pandas as pd
import pdfplumber
import easyocr
from PIL import Image
import numpy as np
from io import BytesIO

# Initialize EasyOCR once
reader = easyocr.Reader(['en'])

# ---------------- Extract Text ----------------
def extract_text(file):
    text = ""
    if file.type in ["application/pdf"]:
        with pdfplumber.open(file) as pdf:
            for page in pdf.pages:
                text += page.extract_text() + "\n"
    else:  # Image
        img = Image.open(file).convert("RGB")
        result = reader.readtext(np.array(img))
        for r in result:
            text += r[1] + "\n"
    return text

# ---------------- Extract Name & Account Number ----------------
def extract_account_details(text):
    # Name (assume Name: John Doe)
    name_match = re.search(r"(Name|Account Holder|Holder)\s*[:\-]?\s*([A-Za-z ]+)", text, re.I)
    name = name_match.group(2).strip() if name_match else "Unknown"

    # Account number (mask except last 4)
    acc_match = re.search(r"(Account Number|A/C No|Acc No)\s*[:\-]?\s*(\d{4,})", text, re.I)
    if acc_match:
        acc_no = acc_match.group(2)
        acc_no_masked = "*" * (len(acc_no)-4) + acc_no[-4:]
    else:
        acc_no_masked = "Unknown"

    return name, acc_no_masked

# ---------------- Credit / Debit / Balance ----------------
def credit_debit_balance(text):
    debit, credit, balance = 0, 0, 0
    # Example regex to find numbers in "Debit" or "Credit" lines
    lines = text.splitlines()
    for line in lines:
        if re.search(r"Debit", line, re.I):
            num = re.findall(r"\d+[\.,]?\d*", line.replace(",",""))
            debit += sum([float(n) for n in num]) if num else 0
        elif re.search(r"Credit", line, re.I):
            num = re.findall(r"\d+[\.,]?\d*", line.replace(",",""))
            credit += sum([float(n) for n in num]) if num else 0
        elif re.search(r"Balance|Available Balance", line, re.I):
            num = re.findall(r"\d+[\.,]?\d*", line.replace(",",""))
            if num:
                balance = float(num[-1])
    return round(credit,2), round(debit,2), round(balance,2)

# ---------------- Abbreviation Explanation ----------------
ABBR_DICT = {
    "ATM": "Cash Withdrawal",
    "NEFT": "National Electronic Fund Transfer",
    "RTGS": "Real Time Gross Settlement",
    "POS": "Point of Sale",
    "IMPS": "Immediate Payment Service"
}

def explain_abbreviations(text):
    found = []
    for abbr in ABBR_DICT:
        if re.search(r"\b" + abbr + r"\b", text):
            found.append(f"{abbr}: {ABBR_DICT[abbr]}")
    return found

# ---------------- Expense Categorization ----------------
def expense_categorization(text):
    categories = {"Food":0, "Shopping":0, "Cash":0}
    lines = text.splitlines()
    for line in lines:
        amt = re.findall(r"\d+[\.,]?\d*", line.replace(",",""))
        amt = float(amt[0]) if amt else 0
        if re.search(r"Restaurant|Cafe|Food|Dine", line, re.I):
            categories["Food"] += amt
        elif re.search(r"Amazon|Shopping|Store|Mall", line, re.I):
            categories["Shopping"] += amt
        elif re.search(r"ATM|Cash", line, re.I):
            categories["Cash"] += amt
    return categories
