DB_PATH = "chat__hist.db"

def init_db():
    conn = sqlite3.connect(DB_PATH)
    cur = conn.cursor()
    cur.execute("""
        CREATE TABLE IF NOT EXISTS sessions (
            session_id INTEGER PRIMARY KEY AUTOINCREMENT,
            created_at DATETIME
        )
    """)
    cur.execute("""
        CREATE TABLE IF NOT EXISTS chat (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            session_id INTEGER,
            sender TEXT,
            message TEXT,
            timestamp DATETIME
        )
    """)
    conn.commit()
    conn.close()

def create_new_session():
    conn = sqlite3.connect(DB_PATH)
    cur = conn.cursor()
    cur.execute("INSERT INTO sessions DEFAULT VALUES")
    sid = cur.lastrowid
    conn.commit()
    conn.close()
    return sid

def save_to_db(sender, message):
    conn = sqlite3.connect(DB_PATH)
    cur = conn.cursor()
    cur.execute(
        "INSERT INTO chat (session_id, sender, message, timestamp) VALUES (?, ?, ?, ?)",
        (st.session_state.session_id, sender, message, datetime.now())
    )
    conn.commit()
    conn.close()

def load_session(session_id):
    conn = sqlite3.connect(DB_PATH)
    cur = conn.cursor()
    cur.execute(
        "SELECT sender, message FROM chat WHERE session_id=? ORDER BY timestamp",
        (session_id,)
    )
    rows = cur.fetchall()
    conn.close()
    st.session_state.session_id = session_id
    st.session_state.chat_history = rows

init_db()

# ---------------- MODELS ----------------
vectorizer = pickle.load(open("models/vectorizer.pkl", "rb"))
model = pickle.load(open("models/model.pkl", "rb"))
label_encoder = pickle.load(open("models/label_encoder.pkl", "rb"))
df_faq = pd.read_excel("data/FAQ_dataset.xlsx")

def chatbot_faq(query):
    try:
        vec = vectorizer.transform([query])
        probs = model.predict_proba(vec)[0]
        if max(probs) < 0.2:
            return None
        pred = model.predict(vec)[0]
        intent = label_encoder.inverse_transform([pred])[0]
        ans = df_faq[df_faq["intent"] == intent]["answer"]
        return ans.sample(1).values[0] if not ans.empty else None
    except:
        return None

