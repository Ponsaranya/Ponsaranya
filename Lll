if uploaded and not st.session_state.ocr_mode and not st.session_state.invalid_upload_handled:
    text = extract_text(uploaded)
    df = extract_transactions(text)
    name, acc = extract_name_account(text)

    # ❌ INVALID BANK STATEMENT
    if name == "Not Found" or acc == "Not Found" or df.empty:
        error_msg = (
            "❗ Kindly upload a valid bank statement.\n\n"
            "Account details or transactions were not found."
        )

        st.session_state.chat_history += [
            ("You", "File uploaded"),
            ("Bot", error_msg)
        ]
        save_to_db("You", "File uploaded")
        save_to_db("Bot", error_msg)

        # 🛑 STOP LOOP
        st.session_state.invalid_upload_handled = True
        st.rerun()

    # ✅ VALID BANK STATEMENT
    st.session_state.ocr_df = df
    st.session_state.ocr_meta = {"name": name, "account": acc}
    st.session_state.ocr_mode = True
    st.session_state.invalid_upload_handled = False  # reset flag

    bot_msg = (
        "Your document has been successfully uploaded.\n\n"
        f"Account Holder Name: {name}\n"
        f"Account Number: {acc}\n\n"
        "Choose one option:\n"
        "1. Credit & Debit Summary\n"
        "2. Abbreviations\n"
        "3. Expense Analysis\n"
    )

    st.session_state.chat_history += [
        ("You", "Bank statement uploaded"),
        ("Bot", bot_msg)
    ]
    save_to_db("You", "Bank statement uploaded")
    save_to_db("Bot", bot_msg)
    st.rerun()
