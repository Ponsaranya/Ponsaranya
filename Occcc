vectorizer = pickle.load(open("models/vectorizer.pkl", "rb"))
model = pickle.load(open("models/model.pkl", "rb"))
label_encoder = pickle.load(open("models/label_encoder.pkl", "rb"))
df_faq = pd.read_excel("data/FAQ_dataset.xlsx")

def chatbot_faq(user_query):
    try:
        qv = vectorizer.transform([user_query])
        probs = model.predict_proba(qv)[0]
        if max(probs) < 0.20:
            return None
        pred = model.predict(qv)[0]
        intent = label_encoder.inverse_transform([pred])[0]
        answers = df_faq[df_faq["intent"] == intent]["answer"]
        return answers.sample(1).values[0] if not answers.empty else None
    except:
        return None

# =========================
# OCR SETUP
# =========================
reader = easyocr.Reader(['en'], gpu=False)

def extract_text(file):
    text = ""
    if file.type == "application/pdf":
        with pdfplumber.open(file) as pdf:
            for page in pdf.pages:
                if page.extract_text():
                    text += page.extract_text()
    else:
        img = Image.open(file)
        arr = np.array(img)
        result = reader.readtext(arr)
        text = " ".join([r[1] for r in result])
    return text

def extract_transactions(text):
    rows = []
    pattern = r'(\d{2}/\d{2}/\d{4})\s+(.*?)\s+([\d,]+\.\d{2})?\s+([\d,]+\.\d{2})'
    for m in re.finditer(pattern, text):
        rows.append({
            "description": m.group(2),
            "debit": float(m.group(3).replace(",", "")) if m.group(3) else 0,
            "credit": float(m.group(4).replace(",", "")) if m.group(4) else 0
        })
    return pd.DataFrame(rows)

