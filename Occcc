# =========================
# MESSAGE HANDLER
# =========================
def submit_message():
    msg = st.session_state.get("chat_input", "").strip()
    if not msg:
        return

    # OCR flow
    if st.session_state.ocr_mode and msg in ["1", "2", "3"]:
        df = st.session_state.ocr_df

        if msg == "1":
            credit = df["credit"].sum()
            debit = df["debit"].sum()
            balance = credit - debit
            reply = f"Total Credit: {credit}\nTotal Debit: {debit}\nFinal Balance: {balance}"

        elif msg == "2":
            abbr = {
                "UPI": "Unified Payments Interface",
                "IMPS": "Immediate Payment Service",
                "NEFT": "National Electronic Funds Transfer",
                "ATM": "Cash Withdrawal"
            }
            found = set()
            for d in df["description"]:
                for k, v in abbr.items():
                    if k in d.upper():
                        found.add(f"{k}: {v}")
            reply = "\n".join(found) if found else "No abbreviations found."

        else:
            food = df[df["description"].str.upper().str.contains("ZOMATO|SWIGGY")]["debit"].sum()
            shop = df[df["description"].str.upper().str.contains("AMAZON|FLIPKART")]["debit"].sum()
            reply = f"Food expenses: {food}\nShopping expenses: {shop}"

        st.session_state.chat_history += [("You", msg), ("Bot", reply)]
        save_to_db("You", msg)
        save_to_db("Bot", reply)
        st.session_state.chat_input = ""
        return

    # Normal chatbot flow
    parts = detect_module(msg)
    responses = []

    if parts.get("faq"):
        r = chatbot_faq(parts["faq"])
        if r:
            responses.append(r)

    if parts.get("recommendation"):
        r = get_recommendation(parts["recommendation"])
        if r:
            responses.append(r)

    if not responses:
        responses.append(llm_answer(msg))

    reply = "\n\n".join(responses)
    st.session_state.chat_history += [("You", msg), ("Bot", reply)]
    save_to_db("You", msg)
    save_to_db("Bot", reply)
    st.session_state.chat_input = ""

