import time
import torch
import psutil
from transformers import AutoTokenizer, AutoModelForCausalLM

# Change this to your local model path
model_path = r"C:\Users\YOUR_PATH\falcon7b"

prompt = "Explain the purpose of a Solution Intent document in simple terms."

def test_model(model_path, model_name):
    print(f"\nTesting: {model_name}")

    start_mem = psutil.virtual_memory().used / (1024 ** 3)
    start_load = time.time()

    tokenizer = AutoTokenizer.from_pretrained(model_path)

    device = "cuda" if torch.cuda.is_available() else "cpu"
    print("Using device:", device)

    model = AutoModelForCausalLM.from_pretrained(
        model_path,
        torch_dtype=torch.float16 if torch.cuda.is_available() else torch.float32,
        low_cpu_mem_usage=True
    ).to(device)

    model.eval()
    torch.set_grad_enabled(False)

    load_time = time.time() - start_load

    inputs = tokenizer(prompt, return_tensors="pt").to(device)

    start_gen = time.time()
    outputs = model.generate(
        **inputs,
        max_new_tokens=120,
        temperature=0.2,
        do_sample=True
    )
    gen_time = time.time() - start_gen

    end_mem = psutil.virtual_memory().used / (1024 ** 3)

    response = tokenizer.decode(outputs[0], skip_special_tokens=True)

    generated_tokens = outputs.shape[1] - inputs["input_ids"].shape[1]
    tokens_per_sec = generated_tokens / gen_time if gen_time > 0 else 0

    print("\nResponse:\n", response)
    print("\nPerformance:")
    print(f"Load Time: {load_time:.2f} sec")
    print(f"Generation Time: {gen_time:.2f} sec")
    print(f"Tokens/sec: {tokens_per_sec:.2f}")
    print(f"Memory Usage: {end_mem - start_mem:.2f} GB")

test_model(model_path, "Falcon-7B")
