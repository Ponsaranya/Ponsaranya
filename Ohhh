import streamlit as st
import pandas as pd
import sqlite3
from datetime import datetime
from utils.ocr_chat import *

# ---------------- DB SETUP ----------------
DB_PATH = "chat__hist.db"

def init_db():
    conn = sqlite3.connect(DB_PATH)
    cur = conn.cursor()
    cur.execute("""
        CREATE TABLE IF NOT EXISTS sessions (
            session_id INTEGER PRIMARY KEY AUTOINCREMENT,
            created_at DATETIME
        )
    """)
    cur.execute("""
        CREATE TABLE IF NOT EXISTS chat (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            session_id INTEGER,
            sender TEXT,
            message TEXT,
            timestamp DATETIME
        )
    """)
    conn.commit()
    conn.close()

def create_new_session():
    conn = sqlite3.connect(DB_PATH)
    cur = conn.cursor()
    cur.execute("INSERT INTO sessions DEFAULT VALUES")
    sid = cur.lastrowid
    conn.commit()
    conn.close()
    return sid

def save_to_db(sender, message):
    conn = sqlite3.connect(DB_PATH)
    cur = conn.cursor()
    cur.execute(
        "INSERT INTO chat (session_id, sender, message, timestamp) VALUES (?, ?, ?, ?)",
        (st.session_state.session_id, sender, message, datetime.now())
    )
    conn.commit()
    conn.close()

init_db()

# ---------------- SESSION STATE ----------------
if "session_id" not in st.session_state:
    st.session_state.session_id = create_new_session()
if "chat_history" not in st.session_state:
    st.session_state.chat_history = []
if "ocr_text" not in st.session_state:
    st.session_state.ocr_text = None
if "transactions_df" not in st.session_state:
    st.session_state.transactions_df = None
if "uploaded" not in st.session_state:
    st.session_state.uploaded = False
if "awaiting_option" not in st.session_state:
    st.session_state.awaiting_option = False

# ---------------- UI ----------------
st.set_page_config(page_title="Banking OCR ChatBot", layout="wide")
st.title("🏦 Banking ChatBot with OCR")

# Chat display
for sender, msg in st.session_state.chat_history:
    if sender=="You":
        st.markdown(f"**You:** {msg}")
    else:
        st.markdown(f"**Bot:** {msg}")

# Upload file
uploaded_file = st.file_uploader("Upload Bank Statement (PDF / JPG only)", type=["pdf","jpg","jpeg"])
if uploaded_file and not st.session_state.uploaded:
    text = extract_text(uploaded_file)
    details = extract_account_details(text)
    df = extract_transactions(text)
    st.session_state.ocr_text = text
    st.session_state.transactions_df = df
    st.session_state.uploaded = True
    st.session_state.awaiting_option = True

    # Bot reply after upload
    bot_msg = f"Bank statement uploaded successfully.\nName: {details['Name']}\nAccount Number: {details['Account Number']}\nChoose one option:\n1. Credit / Debit Summary\n2. Abbreviation Explanation\n3. Expense Categorization"
    st.session_state.chat_history.append(("Bot", bot_msg))
    save_to_db("Bot", bot_msg)

# User input
user_input = st.text_input("Type your message or option here:")

if user_input:
    st.session_state.chat_history.append(("You", user_input))
    save_to_db("You", user_input)

    # Check if waiting for OCR option
    if st.session_state.awaiting_option and user_input in ["1","2","3"]:
        df = st.session_state.transactions_df
        if user_input=="1":
            c,d,b = credit_debit_balance(df)
            reply = f"Total Credit: {c}\nTotal Debit: {d}\nAvailable Balance: {b}"
        elif user_input=="2":
            abbrs = find_abbreviations(df)
            if abbrs:
                reply = "\n".join([f"{k}: {v}" for k,v in abbrs.items()])
            else:
                reply = "No abbreviations found."
        elif user_input=="3":
            cat = categorize_expenses(df)
            reply = "\n".join([f"{k}: {v}" for k,v in cat.items()])
        st.session_state.chat_history.append(("Bot", reply))
        save_to_db("Bot", reply)
    else:
        # Regular chat (could integrate your LLM here)
        reply = "Sorry, I only process 1, 2, 3 for uploaded bank statements."
        st.session_state.chat_history.append(("Bot", reply))
        save_to_db("Bot", reply)

    st.experimental_rerun()
