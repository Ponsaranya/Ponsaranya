import streamlit as st
import pandas as pd
import pickle
import sqlite3
import os

from utils.recommendation_engine import get_recommendation
from utils.detect import detect_module

# =========================
# DATABASE
# =========================
DB_PATH = "chat__hist.db"

def init_db():
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()

    cursor.execute("""
        CREATE TABLE IF NOT EXISTS sessions (
            session_id INTEGER PRIMARY KEY AUTOINCREMENT,
            created_at DATETIME DEFAULT CURRENT_TIMESTAMP
        )
    """)

    cursor.execute("""
        CREATE TABLE IF NOT EXISTS chat (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            session_id INTEGER,
            sender TEXT,
            message TEXT,
            timestamp DATETIME DEFAULT CURRENT_TIMESTAMP
        )
    """)

    conn.commit()
    conn.close()

def create_new_session():
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()
    cursor.execute("INSERT INTO sessions DEFAULT VALUES")
    session_id = cursor.lastrowid
    conn.commit()
    conn.close()
    return session_id

def save_to_db(sender, message):
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()
    cursor.execute(
        "INSERT INTO chat (session_id, sender, message) VALUES (?, ?, ?)",
        (int(st.session_state.session_id), sender, message)
    )
    conn.commit()
    conn.close()

def load_session(session_id):
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()
    cursor.execute("""
        SELECT sender, message
        FROM chat
        WHERE session_id = ?
        ORDER BY timestamp
    """, (int(session_id),))
    rows = cursor.fetchall()
    conn.close()

    st.session_state.session_id = int(session_id)
    st.session_state.chat_history = [(r[0], r[1]) for r in rows]

# =========================
# INIT
# =========================
init_db()

# =========================
# LOAD MODELS
# =========================
vectorizer = pickle.load(open("models/vectorizer.pkl", "rb"))
model = pickle.load(open("models/model.pkl", "rb"))
label_encoder = pickle.load(open("models/label_encoder.pkl", "rb"))
df_faq = pd.read_excel("data/FAQ_dataset.xlsx")

def chatbot_faq(user_query):
    try:
        query_vec = vectorizer.transform([user_query])
        probs = model.predict_proba(query_vec)[0]
        if max(probs) < 0.20:
            return None
        pred = model.predict(query_vec)[0]
        intent = label_encoder.inverse_transform([pred])[0]
        answers = df_faq[df_faq["intent"] == intent]["answer"]
        return answers.sample(1).values[0] if not answers.empty else None
    except:
        return None

# =========================
# PAGE CONFIG
# =========================
st.set_page_config(page_title="Banking Chatbot", layout="wide")

# =========================
# SESSION STATE INIT
# =========================
if "session_id" not in st.session_state:
    st.session_state.session_id = create_new_session()

if "chat_history" not in st.session_state:
    st.session_state.chat_history = []

# =========================
# MESSAGE HANDLER
# =========================
def submit_message():
    msg = st.session_state.get("chat_input", "").strip()
    if not msg:
        return

    parts = detect_module(msg)
    responses = []

    if parts.get("faq"):
        faq = chatbot_faq(parts["faq"])
        if faq:
            responses.append(faq)

    if parts.get("recommendation"):
        rec = get_recommendation(parts["recommendation"])
        if rec:
            responses.append(rec)

    if not responses:
        responses.append("Please ask something related to banking or product suggestions.")

    final_reply = "\n\n".join(responses)

    st.session_state.chat_history.append(("You", msg))
    st.session_state.chat_history.append(("Bot", final_reply))

    save_to_db("You", msg)
    save_to_db("Bot", final_reply)

    st.session_state.chat_input = ""

# =========================
# HEADER
# =========================
st.markdown("<h1 style='text-align:center'>Banking Chatbot</h1>", unsafe_allow_html=True)
st.markdown("<p style='text-align:center'>Ask about banking and product suggestions</p>", unsafe_allow_html=True)

# =========================
# LAYOUT
# =========================
left, center = st.columns([1.3, 3.7])

# =========================
# LEFT PANEL (HISTORY)
# =========================
with left:
    st.markdown("### Chat History")

    conn = sqlite3.connect(DB_PATH)
    sessions = pd.read_sql(
        "SELECT session_id FROM sessions ORDER BY session_id DESC",
        conn
    )
    conn.close()

    for _, row in sessions.iterrows():
        if st.button(
            f"Conversation {row.session_id}",
            key=f"session_{row.session_id}",
            use_container_width=True
        ):
            load_session(row.session_id)
            st.rerun()

# =========================
# CHAT WINDOW
# =========================
with center:
    for sender, message in st.session_state.chat_history:
        if sender == "You":
            st.markdown(f"**You:** {message}")
        else:
            st.markdown(f"**Bot:** {message}")

    st.text_input(
        "",
        key="chat_input",
        placeholder="Type your message and press Enter",
        on_change=submit_message
    )

    col1, col2 = st.columns([2, 1])

    with col1:
        if st.button("Send"):
            submit_message()

    with col2:
        if st.button("Reset"):
            st.session_state.session_id = create_new_session()
            st.session_state.chat_history = []
            st.rerun()
