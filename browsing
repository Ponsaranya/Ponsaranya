from transformers import AutoModelForCausalLM, AutoTokenizer
import torch
 
MODEL_PATH = "models/phi-2"
tokenizer = AutoTokenizer.from_pretrained(MODEL_PATH,local_files_only=True)
model = AutoModelForCausalLM.from_pretrained(MODEL_PATH,local_files_only=True,torch_dtype=torch.float32)
 
def llm_answer(question: str) -> str:
    prompt = f"""You are a professional banking assistant.
    Guidelines:
    - Answer clearly and professionally.
    - If the question is about banking or finance, give a clear banking-related answer.
    - If the question is general respond politely and professionally.
    - If asked who you are or what you can do, explain that you are a banking assistant.
 
    Question:
    {question}
 
    Answer:
    """
 
    inputs = tokenizer(prompt, return_tensors="pt",truncation=True)
    with torch.no_grad():
        output = model.generate(**inputs, max_new_tokens=40, do_sample=True,repetition_penalty=1.2,temperature=0.7,top_p=0.9)
    decoded = tokenizer.decode(output[0], skip_special_tokens=True)
    if "Answer:" in decoded:
        return decoded.split("Answer:")[-1].strip()
    return decoded
