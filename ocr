import pytesseract
import re
import pandas as pd
from PIL import Image
from pdf2image import convert_from_bytes

# ---------- OCR FUNCTION ----------
def extract_text(file):
    text = ""

    if file.type == "application/pdf":
        images = convert_from_bytes(file.read())
        for img in images:
            text += pytesseract.image_to_string(img)

    else:
        image = Image.open(file)
        text = pytesseract.image_to_string(image)

    return text


# ---------- EXTRACT BASIC DETAILS ----------
def extract_account_details(text):
    name = re.search(r'Name\s*:\s*(.*)', text)
    acc_no = re.search(r'Account Number\s*:\s*([\d\s]+)', text)

    return {
        "Name": name.group(1).strip() if name else "Not Found",
        "Account Number": acc_no.group(1).strip() if acc_no else "Not Found"
    }


# ---------- EXTRACT TRANSACTIONS ----------
def extract_transactions(text):
    rows = []
    pattern = r'(\d{2}/\d{2}/\d{4})\s+(.*?)\s+([\d,]+\.\d{2})?\s+([\d,]+\.\d{2})?\s+([\d,]+\.\d{2})'

    for match in re.finditer(pattern, text):
        rows.append({
            "Date": match.group(1),
            "Description": match.group(2),
            "Debit": match.group(3) or "0",
            "Credit": match.group(4) or "0",
            "Balance": match.group(5)
        })

    df = pd.DataFrame(rows)

    df["Debit"] = df["Debit"].str.replace(",", "").astype(float)
    df["Credit"] = df["Credit"].str.replace(",", "").astype(float)

    return df


# ---------- ABBREVIATIONS ----------
ABBREVIATIONS = {
    "ATM": "Cash Withdrawal",
    "UPI": "Unified Payments Interface",
    "NEFT": "National Electronic Funds Transfer",
    "IMPS": "Immediate Payment Service",
    "POS": "Card Payment",
    "EMI": "Loan Repayment"
}

def find_abbreviations(df):
    found = {}

    for desc in df["Description"]:
        for abbr, meaning in ABBREVIATIONS.items():
            if abbr in desc:
                found[abbr] = meaning

    return found


# ---------- EXPENSE CATEGORIZATION ----------
def categorize_expenses(df):
    categories = {
        "Food": ["ZOMATO", "MCDONALDS"],
        "Shopping": ["AMAZON", "FLIPKART"],
        "Cash": ["ATM"],
        "Transfer": ["UPI", "IMPS", "NEFT"],
        "Charges": ["SERVICE"]
    }

    df["Category"] = "Others"

    for category, keywords in categories.items():
        for keyword in keywords:
            df.loc[df["Description"].str.upper().str.contains(keyword), "Category"] = category

    return df
