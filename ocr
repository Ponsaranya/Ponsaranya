import streamlit as st
from utils import *

st.set_page_config(page_title="Banking OCR ChatBot", layout="wide")

st.title("🏦 Banking ChatBot with OCR")

uploaded_file = st.file_uploader(
    "Upload Bank Statement (PDF / JPG only)",
    type=["pdf", "jpg", "jpeg"]
)

if uploaded_file:
    text = extract_text(uploaded_file)

    details = extract_account_details(text)
    df = extract_transactions(text)

    st.subheader("📄 Account Details")
    st.write(details)

    option = st.radio(
        "Choose an option",
        ("Credit / Debit Summary", "Abbreviations", "Expense Categorization")
    )

    # -------- OPTION 1 --------
    if option == "Credit / Debit Summary":
        st.subheader("💰 Credit & Debit Summary")
        st.write("Total Credit:", df["Credit"].sum())
        st.write("Total Debit:", df["Debit"].sum())
        st.write("Closing Balance:", df["Balance"].iloc[-1])
        st.dataframe(df)

    # -------- OPTION 2 --------
    elif option == "Abbreviations":
        st.subheader("📘 Abbreviations Found")
        abbrs = find_abbreviations(df)

        if abbrs:
            for k, v in abbrs.items():
                st.write(f"**{k}** : {v}")
        else:
            st.write("No abbreviations found.")

    # -------- OPTION 3 --------
    elif option == "Expense Categorization":
        st.subheader("📊 Expense Categorization")
        categorized_df = categorize_expenses(df)
        st.dataframe(categorized_df)
        st.bar_chart(categorized_df.groupby("Category")["Debit"].sum())
