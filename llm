def llm_answer(question: str) -> str:
   # if is_unverifiable(question):
        #return "The information is not available."
    """"
    General-purpose LLM Fallback.
    Used when FAQ and recommender do not match.
    """
    question_clean = question.strip()
    question_lower = question_clean.lower()
 
    is_how_to = question.lower().strip().startswith(("how to","how","steps","guide","procedure","process"))
    prompt = (
    "You are a helpful, factual AI assistant.\n\n"
    "Rules:\n"
    #"- Answer ONLY if the answer if the information is well-known and factual.\n"
    "- If you are not sure,,say exactly:\"This information is not available.\"\n"
    "- Do NOT guess,assume, predict or fabricate information.\n"
    "- If the question asks for steps or guidance, give clear step-by-step instructions.\n"
    "- Otherwise, give a clear factual answer in 1-3 lines.\n"
    #f"{'- Provide clear step-by-step instructions.' if is_how_to else '- Keep the answer concise.'}\n\n"
    f"Question:\n{question_clean}\n\n"
    "Answer:"
    )
 
    inputs = tokenizer(prompt, return_tensors="pt",truncation=True)
    #prompt_len = inputs["input_ids"].shape[1]
    with torch.no_grad():
        output = model.generate(**inputs, max_new_tokens=100, do_sample=False,repetition_penalty=1.2,temperature=0.0,top_p=0.1, pad_token_id=tokenizer.eos_token_id)
    #generated_tokens = output[0][prompt_len:]
    decoded = tokenizer.decode(output[0], skip_special_tokens=True).strip()
    if "Answer:" in decoded:
        return decoded.split("Answer:",1)[-1].strip()
    #uncertain_phrases = ["i think", "likely","might","could be","expected to","probably","possibly","i am not sure","i'm not sure"]
    #if any(phrase in decoded.lower() for phrase in uncertain_phrases):
        #return "The information is not available."
    if not decoded:
        return "The information is not available."
    return decoded
