import time
import torch
from transformers import AutoTokenizer, AutoModelForCausalLM

# 🔹 Change this to your Gemma 3 model path or HF model name
model_name = "google/gemma-3-2b-it"   # or your local folder path

# Load tokenizer & model
tokenizer = AutoTokenizer.from_pretrained(model_name)
model = AutoModelForCausalLM.from_pretrained(
    model_name,
    torch_dtype=torch.float16,
    device_map="auto"
)

prompt = "Explain artificial intelligence in simple terms."

# Tokenize
inputs = tokenizer(prompt, return_tensors="pt").to(model.device)

# Start timer
start_time = time.time()

# Generate response
with torch.no_grad():
    output = model.generate(
        **inputs,
        max_new_tokens=150,
        temperature=0.7,
        do_sample=True
    )

# End timer
end_time = time.time()

# Decode output
response = tokenizer.decode(output[0], skip_special_tokens=True)

# Metrics
response_time = end_time - start_time
num_tokens = output.shape[1] - inputs["input_ids"].shape[1]

print("\nPrompt:\n", prompt)
print("\nResponse:\n", response)
print("\nTime taken:", round(response_time, 3), "seconds")
print("Tokens generated:", num_tokens)
print("Tokens per second:", round(num_tokens / response_time, 2))
