.message {
    display: inline-block;
    padding: 14px 20px;
    border-radius: 16px;
    margin-bottom: 10px;
    max-width: 70%;
    font-size: 16px;
    width: fit-content;
    line-height: 1.4;
    word-wrap: break-word;
}

/* User message (right side) */
.user {
    background-color: #dbeafe;
    float: right;
    clear: both;
    text-align: right;
}

/* Bot message (left side) */
.bot {
    background-color: #e5e7eb;
    float: left;
    clear: both;
    text-align: left;
}

/* Conversation box (left panel) */
.convo-box{
    background-color: #3b82f6; /* blue */
    padding: 10px;
    border-radius: 8px;
}

/* Force blue for all buttons inside convo-box and remove hover effect */
.convo-box button{
    background-color: #3b82f6 !important;
    color: white !important;
    border: none;
}

.convo-box button:hover{
    background-color: #3b82f6 !important; /* no hover change */
}


