# ---------------- MESSAGE HANDLER ----------------

def submit_message():
    msg = st.session_state.chat_input.strip()
    if not msg:
        return

    if st.session_state.ocr_text:
        lower = msg.lower()

        if "credit" in lower and "debit" in lower:
            c, d, b = credit_debit_balance(st.session_state.ocr_text)
            reply = f"Total Credit: {c}\nTotal Debit: {d}\nAvailable Balance: {b}"

        elif "abbreviation" in lower:
            abbr = explain_abbreviations(st.session_state.ocr_text)
            reply = "\n".join(abbr) if abbr else "No abbreviations found."

        elif "expense" in lower:
            exp = expense_categorization(st.session_state.ocr_text)
            reply = (
                f"Food: {exp['Food']}\n"
                f"Shopping: {exp['Shopping']}\n"
                f"Cash: {exp['Cash']}"
            )
        else:
            reply = None

        if reply:
            st.session_state.chat_history.append(("You", msg))
            st.session_state.chat_history.append(("Bot", reply))
            save_to_db("You", msg)
            save_to_db("Bot", reply)
            st.session_state.chat_input = ""
            return

    parts = detect_module(msg)
    responses = []

    if parts.get("faq"):
        faq = chatbot_faq(parts["faq"])
        if faq:
            responses.append(faq)

    if parts.get("recommendation"):
        rec = get_recommendation(parts["recommendation"])
        if rec:
            responses.append(rec)

    if not responses:
        responses.append(llm_answer(msg))

    final = "\n\n".join(responses)
    st.session_state.chat_history.append(("You", msg))
    st.session_state.chat_history.append(("Bot", final))
    save_to_db("You", msg)
    save_to_db("Bot", final)
    st.session_state.chat_input = ""

