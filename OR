import pytesseract
from PIL import Image
from pdf2image import convert_from_bytes
import re

def extract_text(uploaded_file):
    text = ""
    if uploaded_file.type == "application/pdf":
        images = convert_from_bytes(uploaded_file.read())
        for img in images:
            text += pytesseract.image_to_string(img)
    else:
        image = Image.open(uploaded_file)
        text = pytesseract.image_to_string(image)
    return text


def extract_account_details(text):
    name_match = re.search(r'Name\s*[:\-]?\s*(.*)', text, re.IGNORECASE)
    acc_match = re.search(r'Account\s*(No|Number)\s*[:\-]?\s*([\d\s]+)', text, re.IGNORECASE)

    name = name_match.group(1).strip() if name_match else "Not Found"
    acc_no = acc_match.group(2).replace(" ", "") if acc_match else "Not Found"

    if acc_no.isdigit():
        acc_no = "XXXXXX" + acc_no[-4:]

    return name, acc_no


def credit_debit_balance(text):
    credit = sum(float(x.replace(",", "")) for x in re.findall(r'CR\s*([\d,]+\.\d{2})', text))
    debit = sum(float(x.replace(",", "")) for x in re.findall(r'DR\s*([\d,]+\.\d{2})', text))
    balance_match = re.findall(r'Balance\s*([\d,]+\.\d{2})', text)
    balance = balance_match[-1] if balance_match else "Not Found"
    return credit, debit, balance


ABBREVIATIONS = {
    "ATM": "Cash withdrawal from ATM",
    "UPI": "Unified Payments Interface payment",
    "NEFT": "National Electronic Funds Transfer",
    "IMPS": "Immediate Payment Service",
    "POS": "Card payment at store",
    "EMI": "Loan monthly installment"
}


def explain_abbreviations(text):
    results = []
    for k, v in ABBREVIATIONS.items():
        if k in text.upper():
            results.append(f"{k} means {v}")
    return results


def expense_categorization(text):
    categories = {
        "Food": ["ZOMATO", "SWIGGY", "HOTEL"],
        "Shopping": ["AMAZON", "FLIPKART"],
        "Cash": ["ATM"]
    }

    summary = {k: 0 for k in categories}

    for line in text.split("\n"):
        amount_match = re.search(r'([\d,]+\.\d{2})', line)
        if not amount_match:
            continue

        amount = float(amount_match.group(1).replace(",", ""))

        for cat, keywords in categories.items():
            if any(k in line.upper() for k in keywords):
                summary[cat] += amount

    return summary
