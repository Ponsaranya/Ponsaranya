✅ Step 1: Create style.css

Put this file in the same folder as app.py.

/* Page background */
body {
    background-color: #f5f7fb;
}

/* Chat container */
.chat-box {
    max-height: 70vh;
    overflow-y: auto;
    padding: 10px;
}

/* Common message style */
.message {
    padding: 10px 14px;
    border-radius: 10px;
    margin-bottom: 8px;
    max-width: 70%;
    font-size: 14px;
}

/* User message (right side) */
.user {
    background-color: #dbeafe;
    margin-left: auto;
    text-align: right;
}

/* Bot message (left side) */
.bot {
    background-color: #e5e7eb;
    margin-right: auto;
    text-align: left;
}


