def extract_name_account(text):
    name = re.search(r"Name\s*[:\-]?\s*([A-Za-z ]+)", text)

    acc = re.search(
        r"(Account\s*(No|Number)[^\d]{0,10})((\d[\s\-]?){12,20})",
        text,
        re.IGNORECASE
    )

    account_number = (
        re.sub(r"\D", "", acc.group(3)) if acc else "Not Found"
    )

    return (
        name.group(1).strip() if name else "Not Found",
        account_number
    )
✅ This will correctly extract full 16-digit account number
