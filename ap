# =========================
# MESSAGE HANDLER
# =========================
def submit_message():
    msg = st.session_state.get("chat_input", "").strip()
    if not msg:
        return

    if st.session_state.ocr_mode and msg in ["1", "2", "3"]:
        df = st.session_state.ocr_df
        name = st.session_state.ocr_meta["name"]
        acc = st.session_state.ocr_meta["account"]

        if msg == "1":
            debit = df["debit"].sum()
            credit = df["credit"].sum()
            balance = credit - debit

            reply = (
                f"Account Holder Name: {name}\n"
                f"Account Number: {acc}\n\n"
                f"Debit Summary: {debit}\n"
                f"Credit Summary: {credit}\n"
                f"Final Balance: {balance}"
            )

        elif msg == "2":
            abbr = {
                "UPI": "Unified Payments Interface",
                "IMPS": "Immediate Payment Service",
                "NEFT": "National Electronic Funds Transfer",
                "ATM": "Automated Teller Machine"
            }
            found = []
            for d in df["description"]:
                for k, v in abbr.items():
                    if k in d.upper():
                        found.append(f"{k}: {v}")
            reply = "\n".join(set(found)) if found else "No abbreviations found."

        else:
            food = df[df["description"].str.contains("ZOMATO|SWIGGY", case=False)]["debit"].sum()
            shop = df[df["description"].str.contains("AMAZON|FLIPKART", case=False)]["debit"].sum()
            reply = (
                f"Food expenses: {food}\n"
                f"Shopping expenses: {shop}"
            )

        st.session_state.chat_history += [("You", msg), ("Bot", reply)]
        save_to_db("You", msg)
        save_to_db("Bot", reply)
        st.session_state.chat_input = ""
        return

    parts = detect_module(msg)
    responses = []

    if parts.get("faq"):
        r = chatbot_faq(parts["faq"])
        if r:
            responses.append(r)

    if parts.get("recommendation"):
        r = get_recommendation(parts["recommendation"])
        if r:
            responses.append(r)

    if not responses:
        responses.append(llm_answer(msg))

    reply = "\n\n".join(responses)
    st.session_state.chat_history += [("You", msg), ("Bot", reply)]
    save_to_db("You", msg)
    save_to_db("Bot", reply)
    st.session_state.chat_input = ""

